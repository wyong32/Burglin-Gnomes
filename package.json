{
  "name": "burglin-gbnomes-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "sitemap": "npm run generate-sitemap",
    "prebuild": "npm run generate-sitemap",
    "build": "npm run build:client && npm run build:server && npm run prerender",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.js --outDir .ssr",
    "prerender": "node scripts/prerender.js",
    "test:adsense": "node scripts/check-adsense-hardening.mjs",
    "preview": "vite preview",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "youtube:auth": "node scripts/youtube-auth.js",
    "youtube:upload": "node scripts/youtube-upload.js"
  },
  "dependencies": {
    "@vue/server-renderer": "^3.5.35",
    "googleapis": "^173.0.0",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "globals": "^17.5.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "prettier": "3.8.3",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
